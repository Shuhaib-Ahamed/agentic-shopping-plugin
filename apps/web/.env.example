# Gateway env. Never imported by the SPA.

# Model provider: "gemini" (default) or "openai".
MODEL_PROVIDER=gemini

# Gemini (default provider). Required when MODEL_PROVIDER=gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (fallback). Required when MODEL_PROVIDER=openai.
# gpt-5-nano is the cheapest tool-calling model in the lineup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Step cap for the agent loop per shopper turn.
MAX_STEPS=8

# Kapruka MCP. Default is the live public endpoint, no auth.
MCP_SERVER_URL=https://mcp.kapruka.com/mcp
# Set to 1 to use canned mock responses instead of the live MCP.
MCP_MOCK=
